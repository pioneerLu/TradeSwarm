<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>{{ symbol }} {{ trade_date }} TradeSwarm Report</title>
  <style>
    @page {
      size: A4;
      margin: 18mm 16mm;
    }
    body {
      color: #172033;
      font-family: "Microsoft YaHei", "Noto Sans CJK SC", "Segoe UI", Arial, sans-serif;
      font-size: 12px;
      line-height: 1.55;
      margin: 0;
    }
    h1, h2, h3 {
      color: #0f2a4f;
      margin: 0;
    }
    h1 {
      font-size: 26px;
      letter-spacing: 0.02em;
    }
    h2 {
      border-bottom: 1px solid #d9e2ef;
      font-size: 16px;
      margin-top: 22px;
      padding-bottom: 6px;
    }
    .subtitle {
      color: #53657d;
      margin-top: 6px;
    }
    .meta-grid {
      display: grid;
      gap: 8px;
      grid-template-columns: repeat(2, 1fr);
      margin-top: 18px;
    }
    .card {
      background: #f7f9fc;
      border: 1px solid #dce5f1;
      border-radius: 10px;
      padding: 12px 14px;
    }
    .label {
      color: #607086;
      font-size: 10px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .value {
      color: #172033;
      font-size: 13px;
      margin-top: 3px;
      word-break: break-word;
    }
    .section {
      margin-top: 12px;
    }
    .pre {
      background: #fbfcff;
      border: 1px solid #dce5f1;
      border-radius: 8px;
      color: #1f2937;
      font-family: "Consolas", "Courier New", monospace;
      font-size: 10.5px;
      padding: 12px;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .badge {
      background: #e8f1ff;
      border: 1px solid #bfd7ff;
      border-radius: 999px;
      color: #174984;
      display: inline-block;
      font-size: 10px;
      margin: 3px 4px 0 0;
      padding: 2px 8px;
    }
    .footer {
      border-top: 1px solid #d9e2ef;
      color: #7a889a;
      font-size: 10px;
      margin-top: 26px;
      padding-top: 10px;
    }
  </style>
</head>
<body>
  <h1>TradeSwarm 投研报告</h1>
  <div class="subtitle">{{ symbol }} · {{ trade_date }} · {{ export_mode }}</div>

  <div class="meta-grid">
    <div class="card">
      <div class="label">Experiment</div>
      <div class="value">{{ experiment_id }}</div>
    </div>
    <div class="card">
      <div class="label">Analysts</div>
      <div class="value">{{ enabled_analysts | join(", ") }}</div>
    </div>
    <div class="card">
      <div class="label">LLM</div>
      <div class="value">{{ llm_summary }}</div>
    </div>
    <div class="card">
      <div class="label">Strategy Skill</div>
      <div class="value">{{ skill_summary }}</div>
    </div>
  </div>

  {% if input_position %}
  <h2>输入仓位</h2>
  <div class="pre">{{ input_position_json }}</div>
  {% endif %}

  {% if regime_badges %}
  <h2>市场状态与 Skill</h2>
  <div class="section">
    {% for badge in regime_badges %}
    <span class="badge">{{ badge }}</span>
    {% endfor %}
  </div>
  {% endif %}

  <h2>Research Manager 投资计划</h2>
  <div class="pre">{{ research_investment_plan }}</div>

  <h2>Trader 执行计划</h2>
  <div class="pre">{{ trader_investment_plan }}</div>

  <h2>Risk Manager 风控裁决</h2>
  <div class="pre">{{ risk_final_trade_decision }}</div>

  <h2>最终执行载荷</h2>
  <div class="pre">{{ execution_payload_json }}</div>

  <div class="footer">
    Generated by TradeSwarm. Source artifacts: report.json / report.txt / report.html.
  </div>
</body>
</html>
